# Generate .env using scripts/init-env.ps1 or scripts/init-env.sh.
# Keep generated hex values URL-safe; never commit the real .env.
DB_PASSWORD=replace-with-random-32-character-hex
ADMIN_PASSWORD=replace-with-random-password
VIEWER_PASSWORD=replace-with-random-password
API_KEY_A=replace-with-random-64-character-hex-a
API_KEY_B=replace-with-random-64-character-hex-b
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
RETENTION_DAYS=7
HTTP_BIND=127.0.0.1
SYSLOG_BIND=127.0.0.1
